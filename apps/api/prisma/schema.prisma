// PostgreSQL-compatible Prisma schema using SQLite for zero-config local execution.
// Switching to PostgreSQL only requires changing `provider = "postgresql"` and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id
  email             String   @unique
  passwordHash      String
  name              String
  rolesJson         String   // JSON array of Role strings, e.g. '["MENTOR","FACULTY"]'
  status            String   @default("ACTIVE")
  preferredLanguage String?  @default("en")
  synthetic         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentProfile    Student?
  staffProfile      StaffProfile?
  tutorProfile      TutorProfile?
  ownedCases        SupportCase[]  @relation("CaseOwner")
  caseEvents        CaseEvent[]
  actionEvidences   ActionEvidence[]
  outcomeReviews    OutcomeReview[]
  organisedMeetings Meeting[]      @relation("MeetingOrganiser")
  notifications     Notification[]
}

model Student {
  id                    String   @id // Same as studentCode ("S-104") for seamless FK / route lookups
  studentCode           String   @unique
  userId                String?  @unique
  name                  String
  email                 String?
  cohort                String
  course                String   // Department / Course name
  semester              Int      @default(5)
  mentorName            String?
  hasRecentObservations Boolean  @default(true)
  feeStatus             String?  // PAID | PENDING_INSTALLMENT | FEE_SUPPORT_REQUESTED | OVERDUE_BALANCE
  feeDueDate            String?
  feeNote               String?
  counsellingStatus     String?  // NONE | REFERRED | ACTIVE_SUPPORT | COMPLETED
  counsellingUpdatedAt  String?
  counsellingNote       String?
  synthetic             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user             User?                 @relation(fields: [userId], references: [id])
  observations     AcademicObservation[]
  assessments      RiskAssessment[]
  cases            SupportCase[]
  checkIns         StudentCheckIn[]
  consents         ConsentRecord[]
  tutoringSessions TutoringSession[]

  @@index([cohort])
}

model StaffProfile {
  id            String   @id
  userId        String   @unique
  name          String
  role          String   // Primary staff role
  capacitySlots Int      @default(8)
  slotsUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([role])
}

model AcademicObservation {
  id             String   @id @default(cuid())
  studentId      String
  subject        String
  type           String   // ATTENDANCE | MARKS | PARTICIPATION | SKILLS | FEES_TREND | FACULTY_FEEDBACK | HISTORY_EVENT
  period         String
  value          Float?
  denominator    Float?   @default(100)
  observedAt     DateTime
  source         String   @default("LMS")
  isMissing      Boolean  @default(false)
  note           String?
  authorRole     String?
  rating         Int?
  historyCat     String?  // ACADEMIC | ATTENDANCE | CHECKIN | CASE | SUPPORT

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
}

model RiskAssessment {
  id                   String   @id
  studentId            String
  modelVersion         String
  score                Float    @default(0.5)
  needsAttention       Boolean  @default(true)
  signalCategory       String   // NEEDS_ATTENTION | MONITOR | ROUTINE | INSUFFICIENT_DATA
  attentionSummary     String
  observedJson         String   // JSON array of EvidenceItem
  modelExplanationJson String   // JSON array of EvidenceItem
  hypothesisedJson     String   // JSON array of EvidenceItem
  studentConfirmedJson String   // JSON array of EvidenceItem or RestrictedField
  limitations          String
  source               String   // ML | FALLBACK | MOCK | UNAVAILABLE
  synthetic            Boolean  @default(true)
  createdAt            DateTime @default(now())

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cases   SupportCase[]

  @@index([studentId, createdAt])
}

model SupportCase {
  id                String    @id // Same as caseCode ("C-104")
  caseCode          String    @unique
  studentId         String?   // Nullable for cohort-level FACULTY_REVIEW_TASK
  studentName       String
  cohort            String
  assessmentId      String?
  suggestedAction   String?   // InterventionType
  approvedAction    String?   // InterventionType
  ownerId           String?
  ownerName         String?
  ownerRole         String?
  priority          Int       @default(1)
  status            String    @default("NEEDS_REVIEW")
  deadline          DateTime?
  plainLanguageReason String
  overrideReason    String?
  escalatedToHod    Boolean   @default(false)
  version           Int       @default(1)
  synthetic         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student    Student?        @relation(fields: [studentId], references: [id])
  assessment RiskAssessment? @relation(fields: [assessmentId], references: [id])
  owner      User?           @relation("CaseOwner", fields: [ownerId], references: [id])
  events     CaseEvent[]
  evidences  ActionEvidence[]
  outcomes   OutcomeReview[]

  @@index([studentId])
  @@index([status])
  @@index([ownerId])
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  actorId     String?
  actorName   String
  actorRole   String
  action      String   // CREATED | STATUS_CHANGE | ASSIGNED | OVERRIDDEN | ESCALATED | EVIDENCE_ADDED | OUTCOME_RECORDED
  fromStatus  String?
  toStatus    String?
  summary     String
  metadata    String?  // Detail / JSON string
  createdAt   DateTime @default(now())

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id])

  @@index([caseId, createdAt])
}

model ActionEvidence {
  id         String   @id
  caseId     String
  authorId   String?
  authorName String
  authorRole String
  type       String   // MEETING_NOTES | ATTENDANCE_VERIFICATION | TUTORING_SUMMARY | FEE_PLAN_AGREEMENT | FOLLOW_UP_OBSERVATION
  note       String
  date       String
  createdAt  DateTime @default(now())

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id])

  @@index([caseId])
}

model OutcomeReview {
  id                 String   @id
  caseId             String
  reviewerId         String?
  recordedBy         String
  classification     String   // IMPROVEMENT | NO_CHANGE | UNKNOWN
  measuresJson       String   // JSON array of strings
  note               String
  recordedAt         DateTime @default(now())

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer    User?       @relation(fields: [reviewerId], references: [id])

  @@index([caseId])
}

model StudentCheckIn {
  id                      String   @id
  studentId               String
  contextNote             String
  supportRequested        String   // NONE | ACADEMIC_TUTORING | MENTOR_CHECKIN | COUNSELLING_REFERRAL | FEE_GUIDANCE
  optionalSupportDecision String   @default("ACCEPT")
  sharingOptionsJson      String   // JSON array of { recipientRole, allowed }
  createdAt               DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model ConsentRecord {
  id            String   @id
  studentId     String
  scope         String   // CHECKIN_NOTES | COUNSELLING_REFERRAL_STATUS | FINANCIAL_SUPPORT_STATUS | ATTENDANCE_AND_MARKS
  scopeLabel    String
  recipientRole String   // MENTOR | FACULTY | HOD | COUNSELLOR | FINANCE | PEER_TUTOR
  granted       Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, scope, recipientRole])
  @@index([studentId])
}

model TutorProfile {
  id                  String   @id // e.g. "T-201"
  userId              String?  @unique
  name                String
  cohort              String
  isVerified          Boolean  @default(true)
  timezone            String   @default("Asia/Kolkata")
  activeSessionsCount Int      @default(0)
  maxWeeklySessions   Int      @default(5)

  user          User?               @relation(fields: [userId], references: [id])
  eligibilities TutorEligibility[]
  slots         TutorAvailability[]
  sessions      TutoringSession[]
}

model TutorEligibility {
  id             String @id @default(cuid())
  tutorProfileId String
  subject        String
  status         String @default("VERIFIED") // VERIFIED | PENDING | REVOKED

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, status])
}

model TutorAvailability {
  id             String  @id
  tutorProfileId String
  startIso       String
  endIso         String
  isBooked       Boolean @default(false)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
}

model TutoringSession {
  id                String   @id
  tutorId           String
  tutorName         String
  studentId         String
  studentName       String
  subject           String
  slotId            String
  startIso          String
  endIso            String
  status            String   @default("REQUESTED") // REQUESTED | ACCEPTED | DECLINED | COMPLETED | CANCELLED
  caseId            String?
  academicGoalNote  String?
  feedbackSubmitted Boolean  @default(false)
  createdAt         DateTime @default(now())

  tutor    TutorProfile     @relation(fields: [tutorId], references: [id])
  student  Student          @relation(fields: [studentId], references: [id])
  feedback SessionFeedback?

  @@index([tutorId, status])
  @@index([studentId])
}

model SessionFeedback {
  id                  String   @id @default(cuid())
  sessionId           String   @unique
  topicsCovered       String
  studentEngagement   String   // ENGAGED | PARTIAL | NEEDS_FOLLOW_UP
  followUpRecommended Boolean  @default(false)
  note                String?
  createdAt           DateTime @default(now())

  session TutoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Meeting {
  id                 String    @id
  title              String
  organiserId        String
  organiserName      String
  participantIds     String    // JSON array
  participantNames   String    // JSON array
  startIso           String
  endIso             String
  timezone           String    @default("Asia/Kolkata")
  syncStatus         String    @default("SYNCED") // PENDING | SYNCED | FAILED
  integrationMode    String    @default("MOCK")   // MOCK | LIVE | DISABLED
  locationOrLink     String?
  caseId             String?
  googleEventId      String?
  meetLink           String?
  calendarError      String?
  calendarSyncedAt   DateTime?
  notificationStatus String    @default("PENDING") // PENDING | SENT | FAILED | UNAVAILABLE
  notificationError  String?
  notificationSentAt DateTime?
  createdAt          DateTime  @default(now())

  organiser User @relation("MeetingOrganiser", fields: [organiserId], references: [id])

  @@index([organiserId])
}

model GoogleOAuthToken {
  id           String    @id
  userId       String?   @unique
  userEmail    String?
  accessToken  String
  refreshToken String?
  scope        String?
  tokenType    String?   @default("Bearer")
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id          String   @id
  recipientId String
  title       String
  summary     String
  channel     String   @default("EMAIL") // EMAIL | IN_APP
  status      String   @default("SENT")  // PENDING | SENT | FAILED | CANCELLED
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

model PastCaseOutcome {
  id               String   @id @default(cuid())
  interventionType String   // PEER_TUTOR | MENTOR | REMEDIAL | FEE_SUPPORT | COUNSELLING_REFERRAL | PLACEMENT_READINESS | PARENT_MEETING
  similarityKey    String   @default("CS_ATTENDANCE_MARKS")
  improved         Boolean
  synthetic        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([interventionType, similarityKey])
}

